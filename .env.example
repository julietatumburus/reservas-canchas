# ----------------------------------------------------------------------------
# Reservas-Canchas — variables de entorno
# Copiá este archivo a ".env" y completá los valores.
# ----------------------------------------------------------------------------

# PostgreSQL (Coolify / Hetzner). Tomá la connection string del servicio Postgres
# de Coolify. Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Para dev local podés usar el Postgres de Coolify expuesto, o uno propio.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reservas?schema=public"

# Dominio raíz para el multitenancy por subdominio.
# Dev:  lvh.me:3000   (lvh.me y *.lvh.me resuelven a 127.0.0.1, soporta wildcard)
# Prod: tuapp.com
NEXT_PUBLIC_ROOT_DOMAIN="lvh.me:3000"

# ---- Auth.js ----
# Generá un secreto con: npx auth secret   (o openssl rand -base64 32)
AUTH_SECRET=""
# Credenciales de Google OAuth (Google Cloud Console). Si quedan vacías, en dev
# se usa solo el login de prueba.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Emails (separados por coma) que son SUPERADMIN de la plataforma.
SUPERADMIN_EMAILS="julitumburus@gmail.com"
# Login de prueba (dev): "true"/vacío = activo en dev; "false" = desactivado.
# Para habilitarlo en PROD (inseguro, solo para testear): ALLOW_DEV_LOGIN="true".
ALLOW_DEV_LOGIN="true"
# Allowlist del login de prueba (coma-separada). Solo estos emails pueden entrar.
# En prod, si queda vacío, NADIE entra por dev-login (salvo SUPERADMIN_EMAILS).
DEV_LOGIN_EMAILS=""

# ---- MercadoPago (iteración 4) ----
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
